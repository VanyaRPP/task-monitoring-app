# === MongoDB ===
PROD_MONGO= # Production MongoDB URI (e.g., from Atlas)
MONGODB_URI= # Development MongoDB URI

# === GitHub OAuth ===
GITHUB_ID= # GitHub OAuth Client ID
GITHUB_SECRET= # GitHub OAuth Client Secret

# === Google OAuth ===
GOOGLE_CLIENT_ID= # Google OAuth Client ID
GOOGLE_CLIENT_SECRET= # Google OAuth Client Secret

# === Facebook OAuth ===
FACEBOOK_CLIENT_ID= # Facebook OAuth App ID
FACEBOOK_CLIENT_SECRET= # Facebook OAuth App Secret

# === NextAuth (Authentication) ===
NEXTAUTH_URL=http://localhost:3000 # Base URL for NextAuth (change in production)
NEXTAUTH_SECRET= # Secret for signing NextAuth JWT tokens

# === Base URLs ===
BASE_URL=http://localhost:3000 # Server base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000 # Client-side base URL (must match server if SSR)

# === Email SMTP Server Settings ===
EMAIL_SERVER=smtp://USER:PASSWORD@HOST:PORT # Full SMTP URL (optional if separate parts defined below)
EMAIL_SERVER_USER= # SMTP server username
EMAIL_SERVER_PASSWORD= # SMTP server password
EMAIL_SERVER_HOST= # SMTP server host (e.g., smtp.mailtrap.io)
EMAIL_SERVER_PORT= # SMTP server port (e.g., 2525)
EMAIL_FROM= # Default "from" address for outgoing emails

# === Google Maps API ===
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY= # Public Google Maps API key (used in client-side)
