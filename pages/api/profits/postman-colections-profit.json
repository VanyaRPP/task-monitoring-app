  "item": [
    {
      "name": "Get all profits (paginated + filter)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/profits?page=1&limit=10&domain=your_domain_id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "profits"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "domain", "value": "your_domain_id" }
          ]
        }
      }
    },
    {
      "name": "Get profit by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/api/profits/{{profitId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "profits", "{{profitId}}"]
        }
      }
    },
