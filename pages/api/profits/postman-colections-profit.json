        "body": {
          "mode": "raw",
          "raw": "{\n  \"domain\": \"your_domain_id\",\n  \"amount\": 1500,\n  \"type\": \"credit\",\n  \"categories\": [\"sales\", \"bonus\"],\n  \"description\": \"Monthly income\",\n  \"date\": \"2025-06-10T00:00:00.000Z\"\n}"
        },
        "url": {
