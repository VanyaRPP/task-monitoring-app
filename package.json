    "prettier:check": "prettier --check --ignore-path .gitignore .",
    "prettier:fix": "prettier --write --ignore-path .gitignore .",
    "browser:open": "open-cli http://localhost:3000",
    "prepare": "husky",
    "types:check": "tsc --noEmit"
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css,yml,yaml}": [
