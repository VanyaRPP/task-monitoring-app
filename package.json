{
  "name": "task-monitoring-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run browser:open && next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:changed": "jest --onlyChanged --passWithNoTests",
    "test:coverage": "jest --coverage",
    "lint": "npm run lint:fix && npm run lint:check",
